{
  "expo": {
    "name": "Fmail",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.fmail.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Dictate emails and join meetings with audio",
        "NSCameraUsageDescription": "Use your camera in Fmail Meet video calls"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF5E00"
      },
      "package": "in.fmail.app",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF5E00"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Use your camera in Fmail Meet video calls"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}